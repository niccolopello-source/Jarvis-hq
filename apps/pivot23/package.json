{
  "name": "pivot23-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test src/lib/pivot/engine.test.ts src/lib/pivot/save.test.ts src/lib/pivot/awards.test.ts src/lib/pivot/determinism.test.ts src/lib/pivot/i18n.test.ts src/lib/pivot/score-line.test.ts src/components/pivot/presentation.test.ts src/components/pivot/i18n-coverage.test.ts src/components/pivot/premiere.test.ts",
    "test:e2e": "playwright test",
    "test:stats": "node --import=tsx --test src/lib/pivot/engine.stats.test.ts",
    "test:all": "pnpm run test && pnpm run test:stats",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test",
    "check:headers": "node scripts/check-headers.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.2.0"
  }
}
